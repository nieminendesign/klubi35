rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC)
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && (
        request.auth.token.role == role ||
        getUserData().role == role
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isCoachOrAdmin() {
      return hasRole('admin') || hasRole('coach');
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'player'
      );
      allow update: if isCoachOrAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        // Players can update their preferredLanguage or avatar, or progress via verified round
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      );
      allow delete: if isAdmin();
    }

    // Training groups collection (public read so registration can list groups)
    match /groups/{groupId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Courses & GPS hole configurations
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Training sessions collection
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isCoachOrAdmin() || (
        isSignedIn() &&
        // Players may only update rsvpPlayerIds or declinedPlayerIds to RSVP or decline
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvpPlayerIds', 'declinedPlayerIds'])
      );
    }

    // 9-Hole Scorecards collection
    match /scorecards/{scorecardId} {
      allow read: if true; // Public read for TV Leaderboard & signed-in members
      allow create: if isSignedIn() && (
        request.resource.data.playerId == request.auth.uid || isCoachOrAdmin()
      );
      allow update: if isCoachOrAdmin() || (
        isSignedIn() &&
        resource.data.playerId == request.auth.uid &&
        resource.data.verifiedByCoach == false
      );
      allow delete: if isAdmin();
    }
  }
}
